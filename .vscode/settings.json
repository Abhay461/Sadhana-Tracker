{
  "java.import.exclusions": [
    "**/node_modules/**",
    "**/.metadata/**",
    "**/build/**",
    "**/.gradle/**",
    "**/.dart_tool/**",
    "**/android/**"
  ],
  "java.import.gradle.enabled": false,
  "java.project.resourceFilters": [
    "node_modules",
    ".metadata",
    "build",
    ".gradle",
    ".dart_tool"
  ]
}
