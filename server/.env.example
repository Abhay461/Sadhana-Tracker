# Application Environment Configuration
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1

# MongoDB Connection String (Atlas or Local)
MONGODB_URI=mongodb://localhost:27017/sadhana_tracker

# Firebase Admin SDK Credentials (Base64 Encoded JSON Service Account Key or JSON Path)
FIREBASE_CREDENTIALS_BASE64=
# Alternatively, specify file path to serviceAccountKey.json (Server-side ONLY)
FIREBASE_CREDENTIALS_PATH=./config/firebase-service-account.json

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,https://sadhana-tracker.example.com

# Throttler Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=60

# Cloudinary Server-side Signature Secret (For signed uploads)
CLOUDINARY_CLOUD_NAME=dxm9zgkv2
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend Email Configuration (Custom Domain Support)
RESEND_API_KEY=re_123456789_example
RESEND_FROM_EMAIL=Sadhana Tracker <noreply@yourdomain.com>

