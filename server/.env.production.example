# Production Environment Configuration Template (.env.production.example)
# DO NOT COMMIT ACTUAL PRODUCTION SECRETS TO GIT REPOSITORY

PORT=3000
NODE_ENV=production
API_PREFIX=api/v1

# Production MongoDB Connection String (Atlas Cluster)
MONGODB_URI=mongodb+srv://PROD_DB_USER:PROD_DB_PASSWORD@prod-cluster.mongodb.net/sadhana_tracker_prod?retryWrites=true&w=majority

# Firebase Production Service Account Credentials (BASE64 Encoded or Path)
FIREBASE_CREDENTIALS_BASE64=
FIREBASE_CREDENTIALS_PATH=./config/firebase-service-account-prod.json

# Production CORS Allowed Origins (Strict Production Domains)
CORS_ORIGINS=https://sadhana.iskcon.org,https://admin.sadhanaapp.org

# Rate Limiting Configuration
THROTTLE_TTL=60000
THROTTLE_LIMIT=30

# Cloudinary Production Credentials (SERVER-SIDE ONLY)
CLOUDINARY_CLOUD_NAME=PROD_CLOUD_NAME
CLOUDINARY_API_KEY=PROD_API_KEY
CLOUDINARY_API_SECRET=PROD_API_SECRET
