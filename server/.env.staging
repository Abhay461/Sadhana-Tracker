# Staging Environment Configuration (ISOLATED STAGING ONLY)
PORT=3000
NODE_ENV=staging
API_PREFIX=api/v1

# Staging MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/sadhana_tracker_staging

# Firebase Staging Credentials (Server-side ONLY)
FIREBASE_CREDENTIALS_BASE64=
FIREBASE_CREDENTIALS_PATH=./config/firebase-service-account.json

# Staging CORS Allowed Origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Throttler Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=60

# Cloudinary Staging Configuration
CLOUDINARY_CLOUD_NAME=dxm9zgkv2
CLOUDINARY_API_KEY=staging_key
CLOUDINARY_API_SECRET=staging_secret

# Resend Email Configuration (Custom Domain Support)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

