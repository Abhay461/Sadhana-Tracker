# Google Play Store Release Keystore Properties Template
# ----------------------------------------------------
# INSTRUCTIONS:
# 1. Generate your release keystore using keytool (see the guide).
# 2. Copy this file, rename it to 'key.properties' in the same folder.
# 3. Replace the placeholder values with your actual keystore details.
# 4. Do NOT check 'key.properties' or your keystore file (.jks/.keystore) into Git!

storePassword=YOUR_KEYSTORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=YOUR_KEY_ALIAS
storeFile=../app/upload-keystore.jks
